{
  // Bornpets sprite sheet config — Badger (pet index 06).
  //
  // RECONSTRUCTED from assets/to-badge/06*.PCX: structure cloned from the panda; this pet has no
  // source config or PNG, so both were rebuilt by decoding the 2bpp PCX
  // frames and replaying asset-gen's sequence layout.
  //
  // Row order IS the PCX "AA" byte (out_row = running asset index), so the
  // `reserved_*` entries below are load-bearing padding: they hold rows the
  // panda leaves empty (0x00, 0x15-0x1F). Delete one and every later
  // animation is renumbered and the firmware loads the wrong sprite.
  //
  // Pass this as the 7th config to `asset-gen export` so file_idx == 0x06.

  image: "bornpets-sprites-badger-v2.png",
  output: "src/fw/game/sprites.rs",
  format: "rle",

  assets: [
    {
      type: "sequence",
      name: "reserved_00",
      comment: "Row 0x00 — no artwork on this pet; keeps row numbering aligned.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "badger_idle",
      comment: "Row 0x01 — BADGER_IDLE.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "badger_happy",
      comment: "Row 0x02 — BADGER_HAPPY.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "badger_critical_sick",
      comment: "Row 0x03 — BADGER_CRITICAL_SICK.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "badger_critical_tired",
      comment: "Row 0x04 — BADGER_CRITICAL_TIRED.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "badger_critical_hungry",
      comment: "Row 0x05 — BADGER_CRITICAL_HUNGRY.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "badger_critical_drained",
      comment: "Row 0x06 — BADGER_CRITICAL_DRAINED.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "badger_warning_sick",
      comment: "Row 0x07 — BADGER_WARNING_SICK.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "badger_warning_tired",
      // Three frames where the panda has one. The firmware does not hardcode
      // frame counts: sprite_loader catalogues every PCX on flash into a
      // per-animation presence bitmap and count_anim_frames returns its
      // trailing_ones, so dropping 060802.PCX in beside 060800/060801 is all it
      // takes for the badge to play a three-frame yawn.
      comment: "Row 0x08 — BADGER_WARNING_TIRED.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "badger_warning_hungry",
      comment: "Row 0x09 — BADGER_WARNING_HUNGRY.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {

{
  // Bornpets sprite sheet config — Jellyfish (pet index 08).
  //
  // Row layout cloned from the badger (and so from the panda); the artwork is
  // generated with scripts/bornpets_ai_frames.py (BORNPETS_PET=jellyfish).
  //
  // Row order IS the PCX "AA" byte (out_row = running asset index), so the
  // `reserved_*` entries below are load-bearing padding: they hold rows the
  // pet leaves empty (0x00, 0x15-0x1F). Delete one and every later
  // animation is renumbered and the firmware loads the wrong sprite.
  //
  // Pass this as the 9th config to `asset-gen export` so file_idx == 0x08.

  image: "bornpets-sprites-jellyfish.png",
  output: "src/fw/game/sprites.rs",
  format: "rle",

  assets: [
    {
      type: "sequence",
      name: "reserved_00",
      comment: "Row 0x00 — no artwork on this pet; keeps row numbering aligned.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_idle",
      comment: "Row 0x01 — JELLYFISH_IDLE.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_happy",
      comment: "Row 0x02 — JELLYFISH_HAPPY.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_critical_sick",
      comment: "Row 0x03 — JELLYFISH_CRITICAL_SICK.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_critical_tired",
      comment: "Row 0x04 — JELLYFISH_CRITICAL_TIRED.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_critical_hungry",
      comment: "Row 0x05 — JELLYFISH_CRITICAL_HUNGRY.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_critical_drained",
      comment: "Row 0x06 — JELLYFISH_CRITICAL_DRAINED.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_warning_sick",
      comment: "Row 0x07 — JELLYFISH_WARNING_SICK.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_warning_tired",
      // Three frames where the panda has one. The firmware does not hardcode
      // frame counts: sprite_loader catalogues every PCX on flash into a
      // per-animation presence bitmap and count_anim_frames returns its
      // trailing_ones, so dropping 060802.PCX in beside 060800/060801 is all it
      // takes for the badge to play a three-frame yawn.
      comment: "Row 0x08 — JELLYFISH_WARNING_TIRED.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_warning_hungry",
      comment: "Row 0x09 — JELLYFISH_WARNING_HUNGRY.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_warning_drained",
      comment: "Row 0x0A — JELLYFISH_WARNING_DRAINED.",
      frames: 5,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "jellyfish_warning_miserable",
      comment: "Row 0x0B — JELLYFISH_WARNING_MISERABLE.",

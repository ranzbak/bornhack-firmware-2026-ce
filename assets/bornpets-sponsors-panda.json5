{
  // Bornpets sprite sheet config — Panda (pet index 05).
  //
  // RECONSTRUCTED from assets/to-badge/05*.PCX: this pet shipped without a
  // source config or PNG, so both were rebuilt by decoding the 2bpp PCX
  // frames and replaying asset-gen's sequence layout.
  //
  // Row order IS the PCX "AA" byte (out_row = running asset index), so the
  // `reserved_*` entries below are load-bearing padding: they hold rows the
  // panda leaves empty (0x00, 0x15-0x1F). Delete one and every later
  // animation is renumbered and the firmware loads the wrong sprite.
  //
  // Pass this as the 6th config to `asset-gen export` so file_idx == 0x05.

  image: "bornpets-sprites-panda.png",
  output: "src/fw/game/sprites.rs",
  format: "rle",

  assets: [
    {
      type: "sequence",
      name: "reserved_00",
      comment: "Row 0x00 — no artwork on this pet; keeps row numbering aligned.",
      frames: 1,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "panda_idle",
      comment: "Row 0x01 — PANDA_IDLE.",
      frames: 1,
      frame_width: 152,
      frame_height: 75,
    },
    {
      type: "sequence",
      name: "panda_happy",
      comment: "Row 0x02 — PANDA_HAPPY.",
      frames: 2,
      frame_width: 152,
      frame_height: 75,
    },
    {
